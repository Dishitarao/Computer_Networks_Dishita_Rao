#include<iostream>
#include<cmath>
using namespace std;
int main()
{
    cout<<"Enter a binary number(4 digits only):";
    int arr[4];
    int m=4;
    for(int i=0;i<4;i++)
    {
        cin>>arr[i];
        if((arr[i]!=0) && (arr[i]!=1))
         { cout<<"Please enter a binary no.";
           break;}
    }
    int r=0;
    while (true)
    {
        if(m+r+1<=pow(2,r))
           break;
        r++;
    }
    cout<<"No. of redundant bits/parity bits="<<r<<endl;
    int n=m+r;
    cout<<"Total length of the code word="<<(m+r)<<endl;
    int ar[8];
    int d=0;
    for(int i=0;i<8;i++)
    {
        ar[i]=0;
    }
    for(int i=7;i>=1;i--)
    {
        if((i&(i-1))!=0)
        {
            ar[i]=arr[d];
            d++;
        }
    }
    for(int i=7;i>=1;i--)
    {
        cout<<ar[i]<<",";
    }
    

for (int i = 1; i <= n; i = i * 2) 
{
    int count = 0;
    
    // Check all positions in the code word
    for (int j = 1; j <= n; j++)
    {
        // Check if position 'j' is monitored by parity bit 'i'
        // (j & i) ensures we only look at positions where the binary 'i' bit is set
        if ((j & i) != 0)
        {
            // If 'j' is not the parity bit itself, count its value
            if (j != i)
            {
                if (ar[j] == 1)
                {
                    count++;
                }
            }
        }
    }
    
    // Even parity rule: if count is odd, set parity bit to 1, else 0
    if (count % 2 != 0)
    {
        ar[i] = 1;
    }
    else
    {
        ar[i] = 0;
    }
}
int error_pos = 0;

for (int i = 1; i <= n; i = i * 2) // i = 1, 2, 4, 8... up to r
{
    int count = 0;
    
    // Check all positions in the received code word (including the parity bit itself this time)
    for (int j = 1; j <= n; j++)
    {
        if ((j & i) != 0)
        {
            if (ar[j] == 1)
            {
                count++;
            }
        }
    }
    
    // For Even Parity: If the total count of 1s is odd, it indicates a mismatch/error.
    // Add the position value 'i' to our error_pos accumulator.
    if (count % 2 != 0)
    {
        error_pos = error_pos + i;
    }
}

// 2. Detect and Correct
if (error_pos == 0)
{
    cout << "\nNo errors detected in the transmission!" << endl;
}
else
{
    cout << "\nError detected at position: " << error_pos << endl;
    
    // Flip the bit at the error position
    if (ar[error_pos] == 1)
    {
        ar[error_pos] = 0;
    }
    else
    {
        ar[error_pos] = 1;
    }
    cout << "Error corrected!" << endl;
}

// 3. Extract Original Data
cout << "Corrected/Original Data Bits: ";
for (int i = 1; i <= n; i++)
{
    // Skip power-of-2 positions and extract only the data bits
    if ((i & (i - 1)) != 0)
    {
        cout << ar[i] << " ";
    }
}
cout << endl;
    
}
