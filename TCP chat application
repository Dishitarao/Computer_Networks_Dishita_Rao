import socket
import time

def main():
    # Brief delay to ensure server is ready
    time.sleep(0.5)

    # 1. Create TCP Socket
    client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

    # 2. Connect to Server
    client_socket.connect(('127.0.0.1', 9999))
    print("[Client] Connected to server!")

    # Exchange Message 1
    msg1 = "Hello Server!"
    client_socket.send(msg1.encode('utf-8'))
    print(f"[Client] Sent: {msg1}")

    reply1 = client_socket.recv(1024).decode('utf-8')
    print(f"[Client] Received: {reply1}")

    # Exchange Message 2
    msg2 = "bye"
    client_socket.send(msg2.encode('utf-8'))
    print(f"[Client] Sent: {msg2}")

    reply2 = client_socket.recv(1024).decode('utf-8')
    print(f"[Client] Received: {reply2}")

    # Clean Close
    client_socket.close()
    print("[Client] Closed connection.")

if __name__ == "__main__":
    main()
